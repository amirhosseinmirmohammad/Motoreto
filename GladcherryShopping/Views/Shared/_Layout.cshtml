<body id="totop">

    <!-- Mobile Loader (shows only on small screens) -->
    <div id="mb-loader" class="mb-loader" aria-live="polite" aria-busy="true">
        <div class="mb-card">
            <!-- SVG -->
            <svg class="mb-svg" width="140" height="140" viewBox="0 0 140 140" aria-hidden="true">
                <defs>
                    <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#ff4d4f" />
                        <stop offset="100%" stop-color="#00016e" />
                    </linearGradient>
                </defs>

                <!-- چرخ‌دنده -->
                <g class="gear" transform="translate(70,70)">
                    <circle r="44" fill="none" stroke="url(#g1)" stroke-width="10" opacity=".25" />
                    <!-- دندانه‌ها -->
                    <g class="teeth" fill="url(#g1)">
                        <rect x="-4" y="-62" width="8" height="16" rx="2" />
                        <use href="#t" />
                    </g>
                    <!-- 12 دندانه با چرخش‌های مساوی -->
                    <g id="t" fill="url(#g1)">
                        <!-- 12 clone via <use> -->
                        <use href="#tooth" transform="rotate(30)" />
                    </g>
                    <g id="tooth" fill="url(#g1)">
                        <rect x="-4" y="-62" width="8" height="16" rx="2" />
                        <use href="#tooth2" />
                    </g>
                </g>

                <!-- از آنجا که برخی مرورگرها از use تودرتو ایراد می‌گیرند، دندانه‌ها را دستی می‌سازیم -->
                <g class="gear-teeth" transform="translate(70,70)" fill="url(#g1)">
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(0)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(30)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(60)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(90)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(120)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(150)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(180)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(210)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(240)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(270)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(300)" />
                    <rect x="-4" y="-62" width="8" height="16" rx="2" transform="rotate(330)" />
                </g>

                <!-- خودرو ساده -->
                <g class="car" transform="translate(18,70)">
                    <rect x="8" y="-8" width="80" height="18" rx="8" fill="#ffffff" opacity=".95" />
                    <rect x="24" y="-16" width="42" height="14" rx="6" fill="#ffffff" opacity=".95" />
                    <!-- چرخ‌ها -->
                    <g class="wheel" transform="translate(26,12)">
                        <circle r="8" fill="#fff" />
                        <circle r="4" fill="url(#g1)" />
                    </g>
                    <g class="wheel" transform="translate(70,12)">
                        <circle r="8" fill="#fff" />
                        <circle r="4" fill="url(#g1)" />
                    </g>
                </g>
            </svg>

            <div class="mb-caption">هوای ماشینتو داریم</div>
        </div>
    </div>

    <div id="header-area" class="header_area">
        <div class="header_bottom">
            <div class="container">
                <div class="row">
                    <nav role="navigation" class="navbar navbar-default mainmenu">
                        <div class="navbar-header">
                            @*<a href="/"><img src="~/images/sadr_logo.png" title="موتورتو ، فروش آنلاین قطعات خودرو | Motoreto" alt="موتورتو ، فروش آنلاین قطعات خودرو | Motoreto" id="main_logo" /></a>*@
                            <button type="button" data-target="#navbarCollapse" data-toggle="collapse" class="navbar-toggle">
                                <span class="sr-only">Toggle navigation</span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                            </button>
                        </div>
                        <div id="navbarCollapse" class="collapse navbar-collapse">
                            <ul id="fresponsive" class="nav navbar-nav dropdown">
                                <li class="@(Request.Url.AbsolutePath == "/" ? "active" : "")">
                                    <a href="/">صفحه اصلی</a>
                                </li>

                                <li class="dropdown @(Request.Url.AbsolutePath.ToLower().Contains("aboutus")
                          || Request.Url.AbsolutePath.ToLower().Contains("faq")
                          || Request.Url.AbsolutePath.ToLower().Contains("terms")
                          || Request.Url.AbsolutePath.ToLower().Contains("contactus")
                          || Request.Url.AbsolutePath.ToLower().Contains("app") ? "active" : "")">
                                    <a data-toggle="dropdown" class="dropdown-toggle">بیشتر<span class="caret"></span></a>
                                    <ul class="dropdown-menu">
                                        <li class="drop-menu"><a href="/aboutus">درباره ما</a></li>
                                        <li class="drop-menu"><a href="/app">دانلود اپلیکیشن</a></li>
                                        <li class="drop-menu"><a href="/faq">سوالات متداول</a></li>
                                        <li class="drop-menu"><a href="/terms">قوانین و مقررات</a></li>
                                        <li class="drop-menu"><a href="/contactus">تماس با ما</a></li>
                                    </ul>
                                </li>

                                <li class="@(Request.Url.AbsolutePath.ToLower().Contains("blog") ? "active" : "")">
                                    <a href="/blog/all">وبلاگ</a>
                                </li>

                                <li class="dropdown @(Request.Url.AbsolutePath.ToLower().Contains("account") ? "active" : "")">
                                    <a data-toggle="dropdown" class="dropdown-toggle">حساب کاربری<span class="caret"></span></a>
                                    <ul class="dropdown-menu">
                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            string UserId = User.Identity.GetUserId();
                                            var Adminrole = content.Roles.Where(p => p.Name == "Administrator").FirstOrDefault();
                                            var Userrole = content.Roles.Where(p => p.Name == "User").FirstOrDefault();
                                            ApplicationUser user = content.Users.Where(current => current.Id == UserId).Include(current => current.Roles).FirstOrDefault();
                                            if (user != null)
                                            {
                                                if (user.Roles.FirstOrDefault().RoleId == Adminrole.Id)
                                                {
                                                    <li class="drop-menu">
                                                        <a href="/Account/AdminPanel">پنل مدیریت</a>
                                                    </li>
                                                }
                                                else if (user.Roles.FirstOrDefault().RoleId == Userrole.Id)
                                                {
                                                    <li class="drop-menu">
                                                        <a href="/Account/UserAccount">پنل کاربری</a>
                                                    </li>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <li class="drop-menu"><a href="/account/loginaccount">ورود</a></li>
                                            <li class="drop-menu"><a href="/account/registeraccount">ثبت نام</a></li>
                                        }
                                    </ul>
                                </li>

                                <li class="@(Request.Url.AbsolutePath.ToLower().Contains("cart") ? "active" : "")">
                                    <a href="/Home/Cart" style="position:relative; display:inline-block;">
                                        <i class="glyphicon glyphicon-shopping-cart" style="font-size:30px;"></i>
                                        <span id="shoppingCount" class="cart-badge">
                                            @{ Html.RenderAction("CartCount", "Home"); }
                                        </span>
                                    </a>
                                </li>
                            </ul>

                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </div>
